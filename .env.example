# Скопируйте в .env и задайте свои значения: cp .env.example .env
# Файл .env в git не попадает.

DB_NAME=guestbook
DB_USER=guestbook
DB_PASSWORD=12345

# Владелец образа в ghcr.io (ваш логин GitHub, в нижнем регистре)
GHCR_OWNER=your-github-login

# Какая версия выкачена: latest, v0.1.0, v0.2.0 ...
IMAGE_TAG=latest
